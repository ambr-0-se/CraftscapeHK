{
  "name": "craftshk-ai-3.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:contracts": "vitest run",
    "contracts:build": "tsc -p shared/tsconfig.build.json",
    "preview": "vite preview",
    "postinstall": "npm run server:install",
    "server:install": "npm --prefix server install",
    "server:build": "npm --prefix server run build",
    "server:seed": "npm --prefix server run seed",
    "server:start": "npm --prefix server run start",
    "server:start:prod": "npm --prefix server run start:prod",
    "server:dev": "npm --prefix server run start:dev",
    "build:stack": "npm run build && npm run server:build",
    "start:prod": "npm run server:start:prod",
    "dev:stack": "concurrently -k --restart-tries 0 \"npm run dev\" \"npm run server:dev\"",
    "dev:stack:watch": "nodemon --config nodemon.env.json",
    "verify:cors": "node verify-cors.cjs",
    "deploy:backend": "pwsh -ExecutionPolicy Bypass -File ./deploy-to-cloudrun.ps1",
    "docker:build": "docker build -f server/Dockerfile -t craftscape-backend .",
    "docker:run": "docker run -p 8080:8080 --env-file .env craftscape-backend",
    "docker:test": "npm run docker:build && npm run docker:run"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "cors": "^2.8.5",
    "framer-motion": "^12.23.19",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "postcss": "^8.5.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.6"
  }
}
